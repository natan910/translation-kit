#!/bin/sh
# Lancia Python della .venv del kit, da qualunque cartella e senza doverla attivare.
# Se la .venv non esiste ancora usa python3 di sistema (e lo dice).
KIT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$KIT/.venv/bin/python" ]; then
  exec "$KIT/.venv/bin/python" "$@"
fi
echo "bin/py: .venv non trovata, uso python3 di sistema (installa con: bash setup.sh)" >&2
exec python3 "$@"
